# ─── Transfeera SDK ─────────────────────────────────────────────────────────────
# Ambiente: sandbox | production
TRANSFEERA_ENVIRONMENT=sandbox

# Credenciais OAuth2 (obtidas no painel Transfeera)
TRANSFEERA_CLIENT_ID=
TRANSFEERA_CLIENT_SECRET=

# ─── mTLS (obrigatório apenas em produção) ──────────────────────────────────────
TRANSFEERA_MTLS_CERT_PATH=
TRANSFEERA_MTLS_KEY_PATH=

# ─── Timeout & Retry ────────────────────────────────────────────────────────────
TRANSFEERA_TIMEOUT=30
TRANSFEERA_RETRY_MAX=3
TRANSFEERA_RETRY_DELAY=100

# ─── Cache ──────────────────────────────────────────────────────────────────────
# Store do Laravel Cache para o token de acesso (padrão: cache da aplicação)
# TRANSFEERA_CACHE_STORE=redis

# ─── User-Agent ─────────────────────────────────────────────────────────────────
# Formato recomendado: "NomeApp (email@dominio.com)"
TRANSFEERA_USER_AGENT="Laravel App (contato@exemplo.com)"

# ─── Sub-APIs ativas ────────────────────────────────────────────────────────────
TRANSFEERA_ENABLE_PAYMENTS=true
TRANSFEERA_ENABLE_RECEIVABLES=true
TRANSFEERA_ENABLE_PIX_AUTOMATICO=true
TRANSFEERA_ENABLE_CONTA_CERTA=true
TRANSFEERA_ENABLE_ACCOUNTS=true
TRANSFEERA_ENABLE_INFRACTIONS=true

# ─── Webhook Secrets ────────────────────────────────────────────────────────────
# TRANSFEERA_WEBHOOK_SECRET=
# TRANSFEERA_WEBHOOK_SECRET_PAYMENTS=
# TRANSFEERA_WEBHOOK_SECRET_RECEIVABLES=
# TRANSFEERA_WEBHOOK_SECRET_CONTA_CERTA=

# ─── App (Testbench) ────────────────────────────────────────────────────────────
APP_KEY=
