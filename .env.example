TRANSFEERA_ENVIRONMENT=sandbox
TRANSFEERA_CLIENT_ID=
TRANSFEERA_CLIENT_SECRET=
TRANSFEERA_CACHE_STORE=file
TRANSFEERA_TIMEOUT=30
TRANSFEERA_RETRY_ATTEMPTS=3
TRANSFEERA_RETRY_DELAY_MS=100
TRANSFEERA_USER_AGENT="Laravel App (contato@exemplo.com)"
TRANSFEERA_WEBHOOK_SECRET=

# Logging (v1.14+)
TRANSFEERA_LOGGING_ENABLED=true
TRANSFEERA_LOGGING_CHANNEL=stack
TRANSFEERA_LOGGING_LEVEL=info
TRANSFEERA_LOGGING_LOG_HEADERS=false
TRANSFEERA_LOGGING_LOG_RESPONSE_BODY=false
TRANSFEERA_LOGGING_SANITIZE=true
TRANSFEERA_LOGGING_MAX_BODY_LENGTH=4096

# Metrics (v1.14+)
TRANSFEERA_METRICS_ENABLED=false
TRANSFEERA_METRICS_PREFIX=transfeera

# mTLS (produção)
TRANSFEERA_MTLS_CERT_PATH=
TRANSFEERA_MTLS_KEY_PATH=

# Webhook Secrets (produção)
TRANSFEERA_WEBHOOK_SECRET_PAYMENTS=
TRANSFEERA_WEBHOOK_SECRET_RECEIVABLES=
TRANSFEERA_WEBHOOK_SECRET_CONTA_CERTA=
