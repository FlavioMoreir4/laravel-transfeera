{
    "name": "flaviomoreir4/laravel-transfeera",
    "description": "SDK Laravel para integração completa com a API Transfeera — Pagamentos, Recebimentos, Pix Automático, Conta Certa e mais.",
    "version": "1.4.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "transfeera",
        "pix",
        "pagamentos",
        "sdk"
    ],
    "authors": [
        {
            "name": "Flávio Moreira",
            "email": "flavio.moreira@mktcode.digital"
        }
    ],
    "require": {
        "php": "^8.3 || ^8.4",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "larastan/larastan": "^3.0 || ^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "FlavioMoreir4\\Transfeera\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlavioMoreir4\\Transfeera\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FlavioMoreir4\\Transfeera\\TransfeeraServiceProvider"
            ],
            "aliases": {
                "Transfeera": "FlavioMoreir4\\Transfeera\\Facades\\Transfeera"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "rector": "rector process src config --dry-run",
        "rector:fix": "rector process src config",
        "rector-fix": "rector process src config"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
